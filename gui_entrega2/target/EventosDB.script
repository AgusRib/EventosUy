CREATE MEMORY TABLE PUBLIC.EDICIONES(ID INTEGER NOT NULL PRIMARY KEY,CIUDAD VARCHAR(255) NOT NULL,FECHAALTA DATE NOT NULL,FECHAFIN DATE NOT NULL,FECHAINICIO DATE NOT NULL,NOMBRE VARCHAR(255) NOT NULL,NOMBREEVENTO VARCHAR(255) NOT NULL,PAIS VARCHAR(255) NOT NULL,SIGLA VARCHAR(255) NOT NULL,ORGANIZADOR_USER_ID INTEGER,CONSTRAINT UNQ_EDICIONES_5 UNIQUE(NOMBRE))
CREATE MEMORY TABLE PUBLIC.REGISTRO(ID INTEGER NOT NULL PRIMARY KEY,COSTO DOUBLE,FECHAREGISTRO DATE NOT NULL,NOMBRETIPOREGISTRO VARCHAR(255) NOT NULL,ASISTENTE_USER_ID INTEGER,EDICION_ID INTEGER,CONSTRAINT FK_REGISTRO_EDICION_ID FOREIGN KEY(EDICION_ID) REFERENCES PUBLIC.EDICIONES(ID))
CREATE MEMORY TABLE PUBLIC.ASISTENTE(USER_ID INTEGER NOT NULL PRIMARY KEY,APELLIDO VARCHAR(255) NOT NULL,EMAIL VARCHAR(255) NOT NULL,FECHA_NAC DATE NOT NULL,NICKNAME VARCHAR(255) NOT NULL,NOMBRE VARCHAR(255),PASSWORD VARCHAR(255),ID_INSTITUCION INTEGER,CONSTRAINT UNQ_ASISTENTE_2 UNIQUE(EMAIL),CONSTRAINT UNQ_ASISTENTE_4 UNIQUE(NICKNAME))
CREATE MEMORY TABLE PUBLIC.ORGANIZADOR(USER_ID INTEGER NOT NULL PRIMARY KEY,DESC VARCHAR(255) NOT NULL,EMAIL VARCHAR(255) NOT NULL,NICKNAME VARCHAR(255) NOT NULL,NOMBRE VARCHAR(255),PASSWORD VARCHAR(255),WEB VARCHAR(255),CONSTRAINT UNQ_ORGANIZADOR_2 UNIQUE(EMAIL),CONSTRAINT UNQ_ORGANIZADOR_3 UNIQUE(NICKNAME))
CREATE MEMORY TABLE PUBLIC.REGISTROS_ARCHIVADOS(ID INTEGER NOT NULL PRIMARY KEY,COSTO DOUBLE NOT NULL,FECHAREGISTRO DATE NOT NULL,NOMBRETIPOREGISTRO VARCHAR(255) NOT NULL,ASISTENTE_USER_ID INTEGER,EDICION_ARCHIVADA_ID INTEGER,CONSTRAINT FK_REGISTROS_ARCHIVADOS_ASISTENTE_USER_ID FOREIGN KEY(ASISTENTE_USER_ID) REFERENCES PUBLIC.ASISTENTE(USER_ID))
CREATE MEMORY TABLE PUBLIC.INSTITUCION(ID INTEGER NOT NULL PRIMARY KEY,DESCRIPCION VARCHAR(255),NOMBRE VARCHAR(255) NOT NULL,WEB VARCHAR(255),CONSTRAINT UNQ_INSTITUCION_2 UNIQUE(NOMBRE))
CREATE MEMORY TABLE PUBLIC.EDICIONES_ARCHIVADAS(ID INTEGER NOT NULL PRIMARY KEY,CIUDAD VARCHAR(255) NOT NULL,FECHAALTA DATE NOT NULL,FECHAFIN DATE NOT NULL,FECHAINICIO DATE NOT NULL,NOMBRE VARCHAR(255) NOT NULL,NOMBREEVENTO VARCHAR(255) NOT NULL,ORGANIZADORNICK VARCHAR(255),PAIS VARCHAR(255) NOT NULL,SIGLA VARCHAR(255) NOT NULL,CONSTRAINT UNQ_EDICIONES_ARCHIVADAS_5 UNIQUE(NOMBRE))
CREATE MEMORY TABLE PUBLIC.ASISTENTE_REGISTRO(ASISTENTE_USER_ID INTEGER NOT NULL,REGISTROS_ID INTEGER NOT NULL,PRIMARY KEY(ASISTENTE_USER_ID,REGISTROS_ID))
CREATE MEMORY TABLE PUBLIC.SEQUENCE(SEQ_NAME VARCHAR(50) NOT NULL PRIMARY KEY,SEQ_COUNT NUMERIC(38))
ALTER TABLE PUBLIC.EDICIONES ADD CONSTRAINT FK_EDICIONES_ORGANIZADOR_USER_ID FOREIGN KEY(ORGANIZADOR_USER_ID) REFERENCES PUBLIC.ORGANIZADOR(USER_ID)
ALTER TABLE PUBLIC.REGISTRO ADD CONSTRAINT FK_REGISTRO_ASISTENTE_USER_ID FOREIGN KEY(ASISTENTE_USER_ID) REFERENCES PUBLIC.ASISTENTE(USER_ID)
ALTER TABLE PUBLIC.ASISTENTE ADD CONSTRAINT FK_ASISTENTE_ID_INSTITUCION FOREIGN KEY(ID_INSTITUCION) REFERENCES PUBLIC.INSTITUCION(ID)
ALTER TABLE PUBLIC.REGISTROS_ARCHIVADOS ADD CONSTRAINT FK_REGISTROS_ARCHIVADOS_EDICION_ARCHIVADA_ID FOREIGN KEY(EDICION_ARCHIVADA_ID) REFERENCES PUBLIC.EDICIONES_ARCHIVADAS(ID)
