<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">

    <property name="severity" value="warning"/>

    <module name="TreeWalker">

        <!-- Evita imports con * -->
        <module name="AvoidStarImport"/>

        <!-- Bloques catch vacíos -->
        <module name="EmptyCatchBlock"/>

        <!-- Espaciado correcto en genéricos (<T, U>) -->
        <module name="GenericWhitespace"/>

        <!-- Evita capturar excepciones genéricas (Exception, Throwable, Error) -->
        <module name="IllegalCatch"/>

        <!-- Llaves de cierre en la misma línea (estilo K&R) -->
        <module name="RightCurly">
            <property name="option" value="same"/>
        </module>

        <!-- Convención de nombres para variables miembro -->
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Convención de nombres para métodos -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Espaciado entre nombre de método y paréntesis -->
        <module name="MethodParamPad"/>

        <!-- Paréntesis innecesarios -->
        <module name="UnnecessaryParentheses"/>

        <!-- Imports no utilizados -->
        <module name="UnusedImports"/>

        <!-- Modificadores de visibilidad (requiere explicitarlos) -->
        <module name="VisibilityModifier"/>

        <!-- Espacios después de comas, puntos y comas -->
        <module name="WhitespaceAfter"/>
    </module>
</module>
